# ── Browser (bundled into the client; must be public-safe) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Server only (never prefix these with VITE_) ─────────────────────────────
# Supabase → Project Settings → API → service_role key. Used by /api/* routes for
# balance changes, bet placement/settlement and payment crediting.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SeevPlus Developer API (https://docs.seevcash.com). Use a sandbox key for testing.
SEEV_CHECKOUT_API_KEY=your_secret_key_here
SEEV_WEBHOOK_SECRET=your_whsec_signing_secret_here
SEEV_SUBACCOUNT_CODE=
SEEV_BASE_URL=https://api.seevplus.com

# Optional: lets a scheduler call GET /api/bets/settle with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
